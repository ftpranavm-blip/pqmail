# Copy this file to `.env` and fill in real values for Real Email Mode.
# NEVER commit the real .env file. Demo Mode does NOT need any of these values.
#
# --- Outgoing mail (SMTP). Use an app password, not your login password. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
#
# --- Incoming mail (IMAP). Use an app password, not your login password. ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_address@gmail.com
IMAP_PASSWORD=your_16_char_app_password
#
# --- Optional application settings ---
# Where the app stores its database, keystores and demo mailbox
PQMAIL_DATA_DIR=data
# 0 disables the public demo accounts (required before listening on a non-local address)
# PQMAIL_DEMO_MODE=1
# Set to 1 when serving over HTTPS so the session cookie is marked Secure
# PQMAIL_COOKIE_SECURE=0
# Flask bind address (keep 127.0.0.1 for local demos)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
